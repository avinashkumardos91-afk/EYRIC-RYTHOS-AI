OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
MODEL_PROVIDER=openai
STATE_DIR=data

# Custom Domain & Security Configuration
# Set PRODUCTION=true to fail closed: the service then refuses to start unless
# API_KEY is set and ALLOWED_ORIGINS is an explicit list (no "*").
PRODUCTION=false
CUSTOM_DOMAIN=api.eyric.ai
ALLOWED_ORIGINS=https://api.eyric.ai,https://eyric.ai,http://localhost:8000
API_KEY=
RATE_LIMIT=60
RATE_WINDOW=60

